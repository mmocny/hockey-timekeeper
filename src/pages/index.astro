---
import Layout from '../layouts/Layout.astro';
import { PlayerCard } from '../components/PlayerCard';
import { GlobalControls } from '../components/GlobalControls';
import { SwapButton } from '../components/SwapButton';
import { INITIAL_PLAYERS } from '../lib/players';

// Group players by position for rendering
const forwards = INITIAL_PLAYERS.filter(p => p.position === 'F');
const defense = INITIAL_PLAYERS.filter(p => p.position === 'D');
const goalies = INITIAL_PLAYERS.filter(p => p.position === 'G');
---

<Layout title="Dashboard">
	<div class="max-w-2xl mx-auto">
		<GlobalControls client:load />

		<div class="space-y-8">
			<section>
				<h2 class="text-xs font-black uppercase tracking-[0.2em] text-slate-500 mb-4 border-b border-slate-800 pb-2 flex justify-between items-center">
					<div class="flex items-center gap-2">
						<span>Forwards</span>
						<span class="text-[10px] bg-slate-800 px-2 py-0.5 rounded">F</span>
					</div>
					<SwapButton client:load position="F" label="Forwards" />
				</h2>
				<div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
					{forwards.map(p => <PlayerCard client:load playerId={p.id} />)}
				</div>
			</section>

			<section>
				<h2 class="text-xs font-black uppercase tracking-[0.2em] text-slate-500 mb-4 border-b border-slate-800 pb-2 flex justify-between items-center">
					<div class="flex items-center gap-2">
						<span>Defense</span>
						<span class="text-[10px] bg-slate-800 px-2 py-0.5 rounded">D</span>
					</div>
					<SwapButton client:load position="D" label="Defense" />
				</h2>
				<div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
					{defense.map(p => <PlayerCard client:load playerId={p.id} />)}
				</div>
			</section>

			<section>
				<h2 class="text-xs font-black uppercase tracking-[0.2em] text-slate-500 mb-4 border-b border-slate-800 pb-2 flex justify-between items-center">
					<div class="flex items-center gap-2">
						<span>Goalie</span>
						<span class="text-[10px] bg-slate-800 px-2 py-0.5 rounded">G</span>
					</div>
				</h2>
				<div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
					{goalies.map(p => <PlayerCard client:load playerId={p.id} />)}
				</div>
			</section>
		</div>
	</div>
</Layout>